{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Swagger": {
    "Enabled": false
  },
  "Database": {
    "AutoMigrateOnStartup": false
  },
  "Cors": {
    "AllowedOrigins": [
      "https://portal.patientmanagement.com"
    ]
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=tcp:<YOUR_AZURE_SQL_SERVER>.database.windows.net,1433;Initial Catalog=PatientManagementDb;Persist Security Info=False;User ID=<YOUR_USER>;Password=<YOUR_PASSWORD>;MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;"
  },
  "AzureBlobStorage": {
    "ConnectionString": "<YOUR_AZURE_BLOB_STORAGE_CONNECTION_STRING>",
    "ContainerName": "patient-pictures"
  },
  "EmailSettings": {
    "SenderEmail": "noreply@patientportal.com",
    "SenderName": "Patient Care Management"
  },
  "Gemini": {
    "ApiKey": "<SET_VIA_AZURE_KEY_VAULT_OR_ENV_VAR>",
    "Model": "gemini-flash-latest",
    "ApiBaseUrl": "https://generativelanguage.googleapis.com/v1beta"
  }
}
