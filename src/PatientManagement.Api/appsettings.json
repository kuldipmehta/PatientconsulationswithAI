{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  },
  "AllowedHosts": "*",
  "Swagger": {
    "Enabled": true
  },
  "Database": {
    "AutoMigrateOnStartup": false
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200",
      "https://localhost:4200"
    ]
  },
  "Jwt": {
    "Issuer": "PatientManagement.Api",
    "Audience": "PatientManagement.Client",
    "ExpiryMinutes": 480,
    "SigningKey": "DEV_ONLY_REPLACE_IN_PRODUCTION_WITH_32+_CHAR_KEY_1234567890"
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=PatientManagementDb;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"
  },
  "AzureBlobStorage": {
    "ConnectionString": "",
    "ContainerName": "patient-pictures"
  },
  "EmailSettings": {
    "SenderEmail": "noreply@patientportal.com",
    "SenderName": "Patient Care Management"
  },
  "Gemini": {
    "ApiKey": "YOUR_GEMINI_API_KEY",
    "Model": "gemini-flash-latest",
    "ApiBaseUrl": "https://generativelanguage.googleapis.com/v1beta"
  }
}
