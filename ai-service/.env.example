# Application Settings
ENVIRONMENT=development
PROJECT_NAME="CareSync FastAPI AI Microservice"
API_V1_STR=/api/v1
HOST=127.0.0.1
PORT=8000
DEBUG=true

# CORS Allowlist (JSON Array)
CORS_ORIGINS=["http://localhost:4200","http://localhost:5056","http://127.0.0.1:4200","http://127.0.0.1:5056"]

# Security & Service Keys
AI_SERVICE_API_KEY=dev-caresync-ai-secret-key-123

# LLM Providers (Google Gemini / Local Ollama)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
